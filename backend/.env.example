APP_TITLE="Document Intelligence API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
DATABASE_URL="postgresql+psycopg://postgres:postgres@127.0.0.1:5432/document_intelligence"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-publishable-or-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-secret-or-service-role-key>"
# Legacy only for older Supabase projects that still use HS256 signing.
SUPABASE_JWT_SECRET=""
OPENROUTER_API_KEY=""
# Separate key for answer generation (google/gemma-4-26b-a4b-it:free via OpenRouter)
ANSWER_API_KEY=""
ANSWER_MODEL="google/gemma-4-26b-a4b-it:free"
ANSWER_MAX_TOKENS="1024"
EMBEDDING_PROVIDER="openrouter"
EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"
EMBEDDING_BATCH_SIZE="32"
EMBEDDING_TIMEOUT_SECONDS="30"
EMBEDDING_MAX_RETRIES="2"
CHUNK_TARGET_TOKENS="500"
CHUNK_OVERLAP_TOKENS="75"
CHUNK_MAX_TOKENS="700"
CHUNK_TOKENIZER_ENCODING="cl100k_base"
